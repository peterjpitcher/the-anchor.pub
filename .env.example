# The Anchor Management System API Key
# Get this from your API provider
ANCHOR_API_KEY=your_api_key_here

# API Base URL (optional - defaults to production)
# ANCHOR_API_BASE_URL=https://management.orangejelly.co.uk/api

# AviationStack API Key for Heathrow flight data
# Get your free key at https://aviationstack.com/
NEXT_PUBLIC_AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# OpenWeatherMap API Key for weather display
# Get your free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Analytics Measurement ID
# Get this from your Google Analytics 4 property
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# GA4 Measurement Protocol — server-side conversion forwarding via /api/analytics
# measurement_id = same G-XXXX as above; api_secret from GA4 Admin > Data Streams >
# Measurement Protocol API secrets. If unset, /api/analytics no-ops gracefully.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_ga4_api_secret

# Meta Pixel for booking conversion tracking
NEXT_PUBLIC_META_PIXEL_ID=757659911002159
CHEERSAI_BOOKING_CONVERSIONS_URL=https://www.cheersai.uk/api/booking-conversions
CHEERSAI_BOOKING_CONVERSIONS_SECRET=changeme-booking-conversion-secret

# CheersAI Tournament Fixture Feed — World Cup 2026
CHEERSAI_FEED_API_KEY=your-cheersai-feed-api-key

# Microsoft Clarity Project ID
# Get this from Clarity project settings
NEXT_PUBLIC_CLARITY_PROJECT_ID=your-clarity-project-id

# PayPal — client ID for inline parking checkout (same value as management tools PAYPAL_CLIENT_ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Cloudflare Turnstile — anti-spam on booking forms
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Microsoft Graph - enquiry email sending
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_USER_EMAIL=
CHRISTMAS_ENQUIRY_TO=manager@the-anchor.pub
RECRUITMENT_APPLICATION_TO=manager@the-anchor.pub

# Delay between recruitment proxy retries in ms (optional - defaults to 2500/4000; tests set 0)
# RECRUITMENT_PROXY_RETRY_DELAY_MS=2500
