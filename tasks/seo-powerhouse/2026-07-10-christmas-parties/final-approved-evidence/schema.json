        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "How much does a Christmas party cost?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Festive menu and buffet prices are confirmed from the current approved source. Room hire and setup options vary by date and party size. Call us on 01753 682707 for a quote tailored to your group."
              }
            },
            {
              "@type": "Question",
              "name": "Are there seasonal offers?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ask about current seasonal options when you enquire. We will only confirm offers that are live for your booking date."
              }
            },
            {
              "@type": "Question",
              "name": "Is there a minimum group size?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Our festive menu is available for Christmas parties of six or more. Smaller groups are welcome to join us from the a la carte menu."
              }
            },
            {
              "@type": "Question",
              "name": "Are you close to Heathrow and Staines?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, seven minutes from Heathrow Terminal 5, around eleven from Terminal 2 and eight minutes from Staines-upon-Thames. We're an easy-to-reach Christmas party venue for Ashford, Windsor, west London and the Heathrow villages."
              }
            },
            {
              "@type": "Question",
              "name": "Can we bring our own food?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ask us before bringing any food or drink from outside. We will confirm what is possible for your booking."
              }
            },
            {
              "@type": "Question",
              "name": "Can you run a bar tab for our group?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ask us about setting an agreed bar-tab limit and the billing options available for your booking."
              }
            },
            {
              "@type": "Question",
              "name": "How do guests travel from Heathrow hotels or terminals?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The pub is around seven minutes from Heathrow Terminal 5 and eleven minutes from Terminal 2, traffic dependent. Share our postcode, TW19 6AQ, so guests can check a live route and fare."
              }
            },
            {
              "@type": "Question",
              "name": "What entertainment can we have?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ask about playlists, DJs, live music, quizzes or karaoke. We will confirm what is suitable for your date, room and finishing time."
              }
            },
            {
              "@type": "Question",
              "name": "Is parking available?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "There are around 20 free spaces on site. Ask the team in advance if anyone needs to leave a vehicle overnight."
              }
            },
            {
              "@type": "Question",
              "name": "How do you handle dietary requests?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Vegetarian, vegan, gluten-free and other dietary requirements are happily accommodated. Include the details on your pre-order so the kitchen can prepare suitable alternatives."
              }
            },
            {
              "@type": "Question",
              "name": "What is a shared Christmas party night?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "A shared party night gives your group its own table while other groups celebrate in the pub at the same time. Ask whether this format is available on your preferred date."
              }
            },
            {
              "@type": "Question",
              "name": "Can we have exclusive use of the whole pub?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ask about exclusive hire when you enquire. Availability depends on your date, guest numbers, layout and planned entertainment. Christmas layouts can host up to 60 seated or 200 standing."
              }
            },
            {
              "@type": "Question",
              "name": "Do you offer corporate Christmas party packages near Heathrow?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "We do. Ask about VAT invoicing and the pre-order process for your team. We're around seven minutes from Heathrow T5 and two minutes from M25 J14, traffic dependent."
              }
            },
            {
              "@type": "Question",
              "name": "Can we book a Christmas party for just drinks, no food?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ask about a drinks-only area and an agreed bar tab. We will confirm suitable spaces and any food options for your date."
              }
            },
            {
              "@type": "Question",
              "name": "What time do Christmas parties start and finish?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Choose a preferred time in the enquiry form. We will confirm the available start and finishing times for your date and party format."
              }
            },
            {
              "@type": "Question",
              "name": "Is The Anchor outside the ULEZ zone?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, the pub is outside the ULEZ boundary and has around 20 free parking spaces on site. Guests should check their own route and current charging rules before travelling."
              }
            },
            {
              "@type": "Question",
              "name": "Can we book a Christmas lunch instead of dinner?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Sit-down Christmas lunches and dinners are available by pre-order only. Tell us your preferred date, sitting, guest count and dietary needs when you enquire."
              }
            },
            {
              "@type": "Question",
              "name": "What's the difference between a Christmas do and a shared party night?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "A Christmas do can be any festive celebration. A shared party night is one format where your group has its own table while other parties use the venue too."
              }
            },
            {
              "@type": "Question",
              "name": "Do you serve a festive menu outside of party bookings?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The sit-down festive menu is available by pre-order for groups of six or more during the confirmed Christmas service window. Ask about other dining options for a smaller group."
              }
            },
            {
              "@type": "Question",
              "name": "Where is The Anchor for Christmas party guests?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "We're on Horton Road in Stanwell Moor, Surrey, at TW19 6AQ. The pub is around seven minutes from Heathrow Terminal 5 and eight minutes from Staines-upon-Thames, traffic dependent, with around 20 free parking spaces on site."
              }
            }
          ]
